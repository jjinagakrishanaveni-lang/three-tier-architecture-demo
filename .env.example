# PostgreSQL Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Cache Settings
REDIS_HOST=redis
REDIS_PORT=6379

# Registration Verification Settings
PENDING_REGISTRATION_TTL=900

# Security Settings
SECRET_KEY=super-secret-jwt-key-for-fastapi-app-change-in-production

# Frontend Public Base URL
FRONTEND_URL=http://localhost:8081

# (Optional) Real SMTP Email Settings - leave empty for simulated console/dev mailbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@authflow.local
